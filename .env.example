# Eshobe CMS connection (platform-injected in production; local dev only).
# Never commit real keys. All CMS credentials stay server-only.
ESHOBE_CMS_URL=http://127.0.0.1:4011
ESHOBE_SITE_DOMAIN=example.test
ESHOBE_SITE_ID=
ESHOBE_API_KEY=
ESHOBE_DEFAULT_LOCALE=fa
ESHOBE_LOCALES=fa,en
ESHOBE_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Preview + revalidation (empty = disabled). Signed raw-body HMAC.
ESHOBE_PREVIEW_SECRET=
ESHOBE_REVALIDATE_SECRET=
# Set true for key-less local host-tenant dev only.
ESHOBE_ALLOW_HOST_TENANT=
# Fixtures for offline UI work (never in production).
ESHOBE_DEV_FIXTURES=
