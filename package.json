{
  "name": "cms-portfolio-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Estudio Bang-inspired portfolio theme for Eshobe CMS (Theme API contractVersion 1).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run vendor:build && next build",
    "start": "next start",
    "typecheck": "npm run vendor:build && tsc --noEmit",
    "lint": "npm run vendor:build && eslint .",
    "test": "npm run vendor:build && vitest run",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "test:watch": "vitest",
    "fonts": "node scripts/fetch-fonts.mjs",
    "verify": "npm run validate:manifest && npm run typecheck && npm run lint && npm test && npm run build",
    "start:standalone": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "mock:cms": "node --experimental-strip-types scripts/mock-cms.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "vendor:build": "tsc -p vendor/site-runtime/tsconfig.json",
    "audit": "node scripts/a11y-audit.mjs && node scripts/interaction-audit.mjs",
    "audit:home": "node scripts/home-canvas-audit.mjs",
    "audit:home:motion": "node scripts/home-canvas-motion.mjs"
  },
  "dependencies": {
    "@eshobe/site-runtime": "file:vendor/site-runtime",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.50.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^30.1.1",
    "puppeteer-core": "^25.12.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
