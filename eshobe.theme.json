{
  "contractVersion": 1,
  "key": "bang-portfolio",
  "name": "BANG — Architectural Portfolio",
  "nameFa": "بنگ — قالب портفولیو معماری",
  "siteTypes": ["portfolio"],
  "locales": ["fa", "en"],
  "proxiesApi": true,
  "capabilities": {
    "projects": true,
    "objects": true,
    "contactForm": true,
    "careersForm": true,
    "team": true,
    "featuredWork": true
  },
  "build": {
    "buildPack": "dockerfile",
    "dockerfileLocation": "Dockerfile",
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "startCommand": "npm run start:standalone",
    "port": 3000,
    "healthCheckPath": "/api/health"
  },
  "deployment": {
    "strategy": "registry_image",
    "registryProvider": "ghcr",
    "registryImageRepository": "ghcr.io/hamidnoshady/cms-portfolio-theme",
    "registryVisibility": "public"
  },
  "env": [
    { "key": "ESHOBE_CMS_URL", "source": "platform", "secret": false },
    { "key": "ESHOBE_API_KEY", "source": "platform", "secret": true },
    { "key": "ESHOBE_SITE_ID", "source": "platform", "secret": false },
    { "key": "ESHOBE_SITE_DOMAIN", "source": "platform", "secret": false },
    { "key": "ESHOBE_PUBLIC_ORIGIN", "source": "platform", "secret": false },
    { "key": "ESHOBE_DEFAULT_LOCALE", "source": "platform", "secret": false },
    { "key": "ESHOBE_LOCALES", "source": "platform", "secret": false },
    { "key": "ESHOBE_PREVIEW_SECRET", "source": "platform", "secret": true },
    { "key": "ESHOBE_REVALIDATE_SECRET", "source": "platform", "secret": true },
    { "key": "ESHOBE_ALLOW_HOST_TENANT", "source": "platform", "secret": false }
  ],
  "design": {
    "background": "#ffffff",
    "foreground": "#000000",
    "primary": "#000000",
    "accent": "#000000",
    "radius": "none",
    "lineHeight": 1.65
  },
  "settings": {
    "canvasMotion": {
      "type": "boolean",
      "label": "Homepage canvas motion",
      "labelFa": "حرکت بوم صفحهٔ اول",
      "default": true
    },
    "canvasDensity": {
      "type": "number",
      "label": "Homepage featured work count",
      "labelFa": "تعداد آثار منتخب در بوم صفحهٔ اول",
      "default": 6,
      "min": 2,
      "max": 12
    },
    "archiveLayout": {
      "type": "select",
      "label": "Archive default layout",
      "labelFa": "چیدمان پیش‌فرض آرشیو",
      "default": "auto",
      "options": [
        { "label": "Auto (index on desktop, cards on mobile)", "labelFa": "خودکار (فهرست در دسکتاپ، کارت در موبایل)", "value": "auto" },
        { "label": "Index list", "labelFa": "فهرست شماره‌دار", "value": "index" },
        { "label": "Editorial grid", "labelFa": "شبکهٔ تصویری", "value": "grid" }
      ]
    }
  },
  "contentSlots": [
    {
      "key": "home",
      "label": "Homepage",
      "labelFa": "صفحهٔ اول",
      "type": "page",
      "required": false,
      "hintSlug": "home"
    },
    {
      "key": "about",
      "label": "About page",
      "labelFa": "صفحهٔ درباره ما",
      "type": "page",
      "required": false,
      "hintSlug": "about"
    },
    {
      "key": "contact",
      "label": "Contact page",
      "labelFa": "صفحهٔ تماس",
      "type": "page",
      "required": false,
      "hintSlug": "contact"
    },
    {
      "key": "careers",
      "label": "Careers page",
      "labelFa": "صفحهٔ همکاری",
      "type": "page",
      "required": false,
      "hintSlug": "careers"
    },
    {
      "key": "legal",
      "label": "Legal / Privacy page",
      "labelFa": "صفحهٔ حقوقی و حریم خصوصی",
      "type": "page",
      "required": false,
      "hintSlug": "legal"
    },
    {
      "key": "projectsCategory",
      "label": "Projects root category",
      "labelFa": "دسته‌بندی ریشهٔ پروژه‌ها",
      "type": "category",
      "required": false,
      "hintSlug": "projects"
    },
    {
      "key": "objectsCategory",
      "label": "Objects root category",
      "labelFa": "دسته‌بندی ریشهٔ آبژه‌ها",
      "type": "category",
      "required": false,
      "hintSlug": "objects"
    },
    {
      "key": "contactForm",
      "label": "Contact form",
      "labelFa": "فرم تماس",
      "type": "form",
      "required": false
    },
    {
      "key": "careersForm",
      "label": "Careers application form",
      "labelFa": "فرم درخواست همکاری",
      "type": "form",
      "required": false
    }
  ]
}
